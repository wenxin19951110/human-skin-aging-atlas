)

print("Figure 2D saved.")


import scanpy as sc
import pandas as pd

# fib 已经加载
sc.tl.rank_genes_groups(
    fib,
    groupby="fib_cluster",
    method="wilcoxon",
    reference="rest",
    use_raw=False,
    n_genes=30
)

top_markers = []

for cluster in sorted(
    fib.obs["fib_cluster"].astype(str).unique(),
    key=int
):
    df = sc.get.rank_genes_groups_df(
        fib,
        group=cluster
    )

    df = df[
        (df["logfoldchanges"] > 0.25) &
        (df["pvals_adj"] < 0.05)
    ].head(10)

    df["cluster"] = cluster
    top_markers.append(df)

marker_table = pd.concat(
    top_markers,
    ignore_index=True
)

display(
    marker_table[
        ["cluster", "names", "logfoldchanges", "pvals_adj"]
    ]
)





import pandas as pd

# 每个cluster的前10个marker放在一行
marker_summary = (
    marker_table
    .groupby("cluster")["names"]
    .apply(lambda x: ", ".join(x))
    .reset_index()
)

marker_summary.columns = [
    "Fibroblast cluster",
    "Top 10 marker genes"
]

pd.set_option("display.max_colwidth", None)
display(marker_summary)


