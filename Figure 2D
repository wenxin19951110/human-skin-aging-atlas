import scanpy as sc
import matplotlib.pyplot as plt
from pathlib import Path

root = Path("/home/ecs-user/skin_spatial_project")

fib = sc.read_h5ad(
    root / "Integrated_8Donor_Skin" /
    "Fibroblast_8Donors_Clustered.h5ad"
)

marker_groups = {
    "Fibroblast identity": [
        "DCN", "LUM", "COL1A1", "COL3A1"
    ],
    "Papillary-like": [
        "APCDD1", "COL18A1", "WIF1", "C7"
    ],
    "Reticular / ECM": [
        "POSTN", "MFAP5", "FBLN5", "MGP"
    ],
    "Perivascular": [
        "RGS5", "PDGFRB", "ACTA2", "TAGLN"
    ],
    "Inflammatory": [
        "CXCL1", "CXCL2", "CXCL8", "CCL2", "IL6"
    ],
    "Cycling": [
        "MKI67", "TOP2A", "UBE2C"
    ]
}

# Filter genes not present in the dataset
markers = {
    name: [g for g in genes if g in fib.var_names]
    for name, genes in marker_groups.items()
}

markers = {k: v for k, v in markers.items() if v}

