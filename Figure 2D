    return_fig=True
)

dp.style(
    cmap="Reds",
    dot_edge_color="white",
    dot_edge_lw=0.2,
    largest_dot=170
)

outdir = root / "Integrated_8Donor_Skin" / "figures"
outdir.mkdir(parents=True, exist_ok=True)

dp.savefig(
