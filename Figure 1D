plt.show()

print("\nSaved PNG:", png)
print("Saved PDF:", pdf)


# Curated compartment assignment from detailed cell labels

epithelia = {
    "Bas KC", "Spn KC I", "Spn KC II",
    "Grn KC", "Cyc KC",
    "Bas Inf", "Diff Inf",
    "Bulge", "ORS Basal", "ORS Suprabasal",
    "IRS/HS", "Melano",
    "Bas Seb", "Diff Seb",
    "Ecc Duct", "Ecc Gland", "Ecc Myoepi"
}

stroma = {
    "Papil Fib", "Retic Fib I", "Retic Fib II",
    "Retic Fib III", "Perivasc Fib I",
    "Perivasc Fib II", "Perineural Fib",
    "Peri", "VEC", "HEC", "LEC",
    "Adipo", "Schwann", "SM", "DS", "DP"
}

immune = {
    "Mac", "Mono", "CD1C+ DC", "CLEC9A+ DC",
    "CCR7+ DC", "Cyc Imm", "LC",
    "CD4+ Th", "CD4+ Treg", "CD8+ Tc",
    "Naive T", "Naïve T",
    "Mast", "Plasma"
}

# Display any labels not captured by our classification
all_labels = set(
    meta["cell_type.detailed"].dropna().astype(str).unique()
)
unmapped = all_labels - epithelia - stroma - immune
print("Unmapped detailed annotations:", sorted(unmapped))

def assign_compartment(ct):
    if ct in epithelia:
        return "Epithelia"
    if ct in stroma:
        return "Stroma"
    if ct in immune:
        return "Immune"
    return "Unassigned"

meta["compartment_refined"] = (
    meta["cell_type.detailed"]
    .astype(str)
    .map(assign_compartment)
)

print("\nRefined counts:")
print(meta["compartment_refined"].value_counts())

# QC: verify each detailed label belongs to one group
print("\nCompartment vs broad annotation:")
print(pd.crosstab(
    meta["compartment_refined"],
    meta["cell_type.broad"]
))

