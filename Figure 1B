def add_scalebar(ax, length=1000, label="1 mm"):
    """
    length: number of spatial coordinate units.
    Use 1000 only after verifying that coordinates are in µm.
    """
    x_left, x_right = ax.get_xlim()
    y_toplimit, y_bottomlimit = ax.get_ylim()

    width = x_right - x_left
    height = abs(y_bottomlimit - y_toplimit)

    # 左下角，适用于invert_yaxis之后的坐标
    x0 = x_left + 0.07 * width
    y0 = max(y_toplimit, y_bottomlimit) - 0.06 * height

    ax.plot(
        [x0, x0 + length],
        [y0, y0],
        color="black",
        linewidth=3.5,
        solid_capstyle="butt",
        clip_on=False
    )

    ax.text(
        x0 + length / 2,
        y0 - 0.025 * height,
        label,
        ha="center",
        va="bottom",
        fontsize=10
    )
ax.set_title(
    f"{title}\n(n={len(xy):,} cells)",
    fontsize=13,
    pad=10
)

ax.set_aspect("equal")
ax.invert_yaxis()
ax.axis("off")

