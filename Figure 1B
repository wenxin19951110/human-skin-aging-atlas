import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.lines import Line2D
from pathlib import Path

root = Path("/home/ecs-user/skin_spatial_project")
outdir = root / "Restrepo_MERFISH" / "figures"
outdir.mkdir(parents=True, exist_ok=True)

# Four previously verified tissue regions
regions = {
    ("inguinal fold", 36): "D151--7-12--03152024.region_5",
    ("inguinal fold", 82): "D149--7-12--04302024.region_1",
    ("buttocks", 36): "D151--7-12--03152024.region_4",
    ("buttocks", 82): "D149--7-12--04302024.region_5",
}

obs = merfish.obs
keep = obs["run_region"].isin(regions.values()).to_numpy()

meta = obs.loc[
    keep,
    ["run_region", "cell_type.broad", "cell_type.detailed"]
].copy().reset_index(drop=True)

coords = np.asarray(merfish.obsm["spatial"])[keep, :2]

valid = ~meta["cell_type.detailed"].astype(str).isin(
    ["Doublet", "Unknown"]
)
coords = coords[valid.to_numpy()]
meta = meta.loc[valid].reset_index(drop=True)

# Reuse previous UMAP colours if available
types = sorted(meta["cell_type.broad"].dropna().unique())

if "palette" not in globals() or not all(
    t in palette for t in types
):
    cmap = plt.get_cmap("tab20", len(types))
    palette = {t: cmap(i) for i, t in enumerate(types)}

# Optional manual overrides after checking the figure
# +1 = original Y direction; -1 = reverse Y direction
manual_y = {}

def orient_epidermis_up(xy, labels, region):
    y = xy[:, 1].copy()

    # Granular KC marks the superficial epidermis;
    # fibroblasts mostly occupy the underlying dermis.
    granular = y[labels == "Grn KC"]
    fibro = y[labels == "Fibro"]

    if len(granular) >= 10 and len(fibro) >= 10:
        sign = (
            1 if np.median(granular) > np.median(fibro)
            else -1
        )
    else:
        sign = 1
        print("Please check orientation manually:", region)

    sign = manual_y.get(region, sign)
    xy_new = xy.copy()
    xy_new[:, 1] *= sign

    print(region, "| Y direction:", sign)
    return xy_new

fig, axes = plt.subplots(2, 2, figsize=(12, 11))

layout = [
    (0, 0, "inguinal fold", 36),
    (0, 1, "inguinal fold", 82),
    (1, 0, "buttocks", 36),
    (1, 1, "buttocks", 82),
]

# Enable physical scale bars only after confirming

# that one spatial coordinate unit equals one micrometre.
spatial_unit_um = None

for r, c, site, age in layout:
    ax = axes[r, c]
    region = regions[(site, age)]

    m = (meta["run_region"] == region).to_numpy()
    xy = coords[m]
    labels = meta.loc[m, "cell_type.broad"].astype(str).to_numpy()

    xy = orient_epidermis_up(xy, labels, region)

    for ct in types:
        cm = labels == ct
        ax.scatter(
            xy[cm, 0], xy[cm, 1],
            s=2.1,
            color=palette[ct],
            alpha=0.85,
            linewidths=0,
            rasterized=True
        )

    ax.set_title(
        f"{'Inguinal fold' if site == 'inguinal fold' else 'Buttocks'}"
        f" | {age}y\n(n={len(xy):,} cells)",
        fontsize=13, pad=10
    )

    ax.set_aspect("equal")
    ax.axis("off")

    # Add 1 mm scale bar only after unit confirmation
    if spatial_unit_um is not None:
        length = 1000 / spatial_unit_um

        xmin, xmax = xy[:, 0].min(), xy[:, 0].max()
        ymin, ymax = xy[:, 1].min(), xy[:, 1].max()
        width, height = xmax-xmin, ymax-ymin

        bx = xmin + 0.07*width
        by = ymin - 0.10*height

        ax.plot(
            [bx, bx+length], [by, by],
            color="black", lw=3.5, clip_on=False
        )
        ax.text(
            bx+length/2, by+0.025*height,
            "1 mm", ha="center", va="bottom",
            fontsize=10
        )

handles = [
    Line2D(
        [0], [0], marker="o", linestyle="",
        markerfacecolor=palette[t],
        markeredgecolor="none",
        markersize=7, label=t
    )
    for t in types
]

fig.legend(
    handles=handles,
    loc="center left",
    bbox_to_anchor=(0.83, 0.5),
    frameon=False, fontsize=9
)

fig.suptitle(
    "MERFISH | Human skin spatial cell atlas",
    fontsize=16, y=0.98
)

fig.subplots_adjust(
    left=0.04, right=0.80,
    top=0.91, bottom=0.05,
    wspace=0.15, hspace=0.16
)

png = outdir / "Fig1D_MERFISH_Spatial_Oriented_FINAL.png"
pdf = outdir / "Fig1D_MERFISH_Spatial_Oriented_FINAL.pdf"

fig.savefig(png, dpi=450, bbox_inches="tight",
            facecolor="white")
fig.savefig(pdf, bbox_inches="tight",
            facecolor="white")
plt.show()

print("Saved:", png)
print("Saved:", pdf)

    
