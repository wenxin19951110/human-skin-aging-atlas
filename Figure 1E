def gene_zscore(df):
    mu = df.mean(axis=0)
    sd = df.std(axis=0, ddof=0).replace(0, np.nan)
    return (df - mu) / sd

# Standardise within each platform
scrna_z = gene_zscore(scrna_mean_df)
merfish_z = gene_zscore(merfish_mean_df)

# Keep only genes with variation in both platforms
valid_genes = (
    scrna_z.notna().all(axis=0) &
    merfish_z.notna().all(axis=0)
)

scrna_z = scrna_z.loc[:, valid_genes]
merfish_z = merfish_z.loc[:, valid_genes]

print("Genes retained after QC:", scrna_z.shape[1])





from scipy.stats import spearmanr

A = scrna_z.to_numpy()
B = merfish_z.to_numpy()

# Spearman correlation between cell-type profiles
cross_corr = np.zeros((A.shape[0], B.shape[0]))

for i in range(A.shape[0]):
    for j in range(B.shape[0]):
        cross_corr[i, j] = spearmanr(
            A[i], B[j]
        ).statistic

cross_corr_df = pd.DataFrame(
    cross_corr,
    index=scrna_z.index,
    columns=merfish_z.index
)

print("Cross-platform matrix:", cross_corr_df.shape)
print("Correlation range:",
      cross_corr_df.min().min(),
