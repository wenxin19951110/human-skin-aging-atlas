    0 if meta.loc[d, "age_group"] == "Young" else 1
    for d in donor_order
]

cohort_vals = [
    0 if meta.loc[d, "cohort"] == "SoleBoldo_2020" else 1
    for d in donor_order
]


# =====================================================
# 6. Figure layout
# =====================================================

