import numpy as np
import pandas as pd
from scipy import sparse
from pathlib import Path

root = Path("/home/ecs-user/skin_spatial_project")
outdir = root / "Integrated_8Donor_Skin" / "figures"
outdir.mkdir(parents=True, exist_ok=True)

# 主分析排除细胞数过少的 LS_S3
adata_de = fib_clean[
    fib_clean.obs["donor_id"].astype(str) != "LS_S3"
].copy()

print("Cells used:", adata_de.n_obs)
print("Donors used:", adata_de.obs["donor_id"].nunique())

# 1. Donor-level mean expression
records = []

for donor in adata_de.obs["donor_id"].unique():
    sub = adata_de[
        adata_de.obs["donor_id"] == donor
    ]

    X = sub.X
    mean_expr = np.asarray(X.mean(axis=0)).ravel()

    info = sub.obs.iloc[0]

    record = pd.Series(
        mean_expr,
        index=adata_de.var_names,
        name=donor
    )

    records.append(record)

donor_expr = pd.DataFrame(records)
donor_expr.index.name = "donor_id"

metadata = (
    adata_de.obs[
        ["donor_id", "cohort", "age_group"]
    ]
    .drop_duplicates("donor_id")
    .set_index("donor_id")
    .loc[donor_expr.index]
)

display(metadata)

# 2. Each cohort: Old minus Young
cohort_effects = {}

for cohort in metadata["cohort"].unique():

    idx = metadata["cohort"] == cohort

    young_ids = metadata.index[
        idx & (metadata["age_group"] == "Young")
    ]

    old_ids = metadata.index[
        idx & (metadata["age_group"] == "Old")
    ]

    young_mean = donor_expr.loc[young_ids].mean()
    old_mean = donor_expr.loc[old_ids].mean()

    cohort_effects[cohort] = old_mean - young_mean

effects = pd.DataFrame(cohort_effects)

# 3. Cross-cohort consistency
effects["mean_delta"] = effects.mean(axis=1)

effects["same_direction"] = (
    (effects.iloc[:, 0] > 0) &
    (effects.iloc[:, 1] > 0)
) | (
    (effects.iloc[:, 0] < 0) &
    (effects.iloc[:, 1] < 0)
)

# Mean expression filter, exploratory only
effects["mean_expression"] = donor_expr.mean(axis=0)

candidates = effects[
    (effects["same_direction"]) &
    (effects["mean_expression"] > 0.05)
].copy()

# Rank by the smaller absolute cohort effect
# Avoid ranking genes driven only by one cohort
cohort_cols = list(cohort_effects.keys())

candidates["min_abs_delta"] = (
    candidates[cohort_cols].abs().min(axis=1)
)

candidates = candidates.sort_values(
    "min_abs_delta",
    ascending=False
)

print("Consistent-direction candidates:",
      len(candidates))

display(candidates.head(30).round(3))

# Save complete tables
effects.to_csv(
    outdir / "Fibroblast_Age_Cohort_Effects_AllGenes.csv"
)

candidates.to_csv(
    outdir / "Fibroblast_Age_Consistent_Candidates.csv"
)

donor_expr.to_csv(
    outdir / "Fibroblast_DonorMean_Expression.csv"
)

print("Saved exploratory age comparison tables.")



import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.colors import TwoSlopeNorm, ListedColormap
from matplotlib.patches import Patch
from pathlib import Path

# =====================================================
# 1. Output directory
# =====================================================

root = Path("/home/ecs-user/skin_spatial_project")

outdir = root / "Integrated_8Donor_Skin" / "figures"
outdir.mkdir(parents=True, exist_ok=True)


# =====================================================
# 2. Donor metadata and actual ages
# =====================================================

age_map = {
    "Butt_23": 23,
    "LS_S1": 25,
    "LS_S2": 27,
    "Butt_53": 53,
    "LS_S5": 69,
    "LS_S4": 70,
    "Butt_85": 85
}

meta = metadata.copy()

meta["age_numeric"] = meta.index.map(age_map)

assert meta["age_numeric"].notna().all(), \
    "Some donor ages are missing!"

donor_order = (
    meta.sort_values("age_numeric").index.tolist()
)

meta = meta.loc[donor_order]

print("Donors sorted by age:")
for donor in donor_order:
    print(donor, int(meta.loc[donor, "age_numeric"]))


# =====================================================
# 3. Select Top 30 candidate genes
# =====================================================

# candidates was generated in our previous analysis
# using consistent Old-vs-Young directions in both cohorts

genes_df = candidates.copy()

genes_df = genes_df[
    genes_df["same_direction"]
].copy()

# Rank using the smaller absolute change across cohorts
genes_df = genes_df.sort_values(
    "min_abs_delta",
    ascending=False
)

# Number of genes displayed
TOP_N = 30

genes_all = [
    g for g in genes_df.index
    if g in donor_expr.columns
][:TOP_N]

print("\nNumber of genes:", len(genes_all))
print("Selected genes:", genes_all)


# =====================================================
# 4. Donor-level expression
# =====================================================

# Rows: genes
# Columns: donors

expr = donor_expr.loc[donor_order, genes_all].T

# Gene-wise Z-score across donors
row_mean = expr.mean(axis=1)
row_std = expr.std(axis=1, ddof=0).replace(0, 1)

z = expr.sub(row_mean, axis=0).div(row_std, axis=0)

z = z.fillna(0)

print("\nHeatmap dimensions:", z.shape)


# =====================================================
# 5. Define annotation colors
# =====================================================

age_colors = {
    "Young": "#4C78A8",
    "Old": "#E08B58"
}

