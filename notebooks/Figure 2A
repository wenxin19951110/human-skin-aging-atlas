import pandas as pd

# 根据已知供体信息建立核对表
donor_info = {
    "LS_S1": (25, "inguinal fold"),
    "LS_S2": (27, "inguinal fold"),
    "LS_S3": (53, "inguinal fold"),
    "LS_S4": (70, "inguinal fold"),
    "LS_S5": (69, "inguinal fold"),
    "Butt_23": (23, "buttock"),
    "Butt_53": (53, "buttock"),
    "Butt_85": (85, "buttock")
}

# 创建独立、标准化的年龄与部位字段
combined.obs["age_years"] = pd.to_numeric(
    combined.obs["unified_donor"].astype(str).map(
        {k: v[0] for k, v in donor_info.items()}
    ),
    errors="coerce"
)

combined.obs["skin_site"] = (
    combined.obs["unified_donor"].astype(str).map(
        {k: v[1] for k, v in donor_info.items()}
    )
)

# 检查是否有未匹配的供体
assert combined.obs["age_years"].notna().all()
assert combined.obs["skin_site"].notna().all()

donor_summary = (
    combined.obs.groupby(
        ["cohort", "unified_donor",
         "age_years", "skin_site"],
        observed=True
    )
    .size()
    .reset_index(name="n_cells")
    .sort_values("age_years")
)

display(donor_summary)

