import pandas as pd
import matplotlib.pyplot as plt

# 以每位供体为统计单位
composition = pd.crosstab(
    combined.obs["unified_donor"],
    combined.obs["unified_broad"]
)

composition_pct = (
    composition.div(composition.sum(axis=1), axis=0)
    * 100
)

# 根据年龄排序
donor_order = (
    donor_summary.sort_values("age_years")
    ["unified_donor"].tolist()
)

composition_pct = composition_pct.loc[donor_order]

# 绘图
fig, ax = plt.subplots(figsize=(13, 6))

composition_pct.plot(
    kind="bar",
    stacked=True,
    ax=ax,
    width=0.8,
    colormap="tab20"
)

ax.set_xlabel("Donor (ascending age)")
ax.set_ylabel("Cell composition (%)")
ax.set_title(
    "Figure 1A | Cell composition across 8 human skin donors"
)
ax.legend(
    title="Cell type",
    bbox_to_anchor=(1.02, 1),
    loc="upper left",
    frameon=False
)

age_map = donor_summary.set_index(
    "unified_donor"
)["age_years"]

ax.set_xticklabels(
    [f"{d}\n{age_map[d]}y" for d in donor_order],
    rotation=0
)

plt.tight_layout()

fig.savefig(
    out / "Fig1A_8Donors_Cell_Composition.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()

