import harmonypy as hm
import numpy as np

# 原始PCA
X_pca = np.asarray(
    atlas.obsm["X_pca"],
    dtype=np.float64
)

print("Original PCA:", X_pca.shape)

# 直接运行Harmony
ho = hm.run_harmony(
    X_pca,
    atlas.obs,
    vars_use=["cohort"],
    max_iter_harmony=20,
    verbose=False
)

# 读取校正结果
Z = np.asarray(ho.Z_corr)

print("Harmony raw output:", Z.shape)

# 自动检查矩阵方向
n_cells, n_pcs = X_pca.shape

if Z.shape == (n_cells, n_pcs):
    X_harmony = Z
elif Z.shape == (n_pcs, n_cells):
    X_harmony = Z.T
else:
    raise ValueError(
        f"Unexpected Harmony shape: {Z.shape}"
    )

# 保存到AnnData
atlas.obsm["X_pca_harmony"] = (
    X_harmony.astype(np.float32)
)

print(
    "Corrected PCA:",
    atlas.obsm["X_pca_harmony"].shape
)

import scanpy as sc

sc.pp.neighbors(
    atlas,
    use_rep="X_pca_harmony",
    n_neighbors=15
)

sc.tl.umap(
    atlas,
    random_state=42
)

sc.pl.umap(
    atlas,
    color=[
        "cohort",
        "unified_broad",
        "age_group"
    ],
    wspace=0.4,
    frameon=False,
    size=5
)









