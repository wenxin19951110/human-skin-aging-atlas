import scanpy as sc
import numpy as np

# 建立分析副本，保留 combined 原始 counts
atlas = combined.copy()

print("Input:", atlas.shape)

# 标准化与log转换
sc.pp.normalize_total(atlas, target_sum=1e4)
sc.pp.log1p(atlas)

# 高变基因选择
sc.pp.highly_variable_genes(
    atlas,
    n_top_genes=3000,
    flavor="seurat",
    batch_key="cohort"
)

print("Highly variable genes:",
      atlas.var["highly_variable"].sum())

# PCA：仅使用高变基因
sc.pp.pca(
    atlas,
    n_comps=50,
    mask_var="highly_variable",
    zero_center=False
)

# 建立邻接图
sc.pp.neighbors(
    atlas,
    n_neighbors=15,
    n_pcs=30
)

# UMAP
sc.tl.umap(atlas, random_state=42)

print("UMAP completed!")




import matplotlib.pyplot as plt

sc.pl.umap(
    atlas,
    color=[
        "cohort",
        "unified_broad",
        "age_group"
    ],
    wspace=0.35,
    frameon=False,
    size=5,
    show=True
)



