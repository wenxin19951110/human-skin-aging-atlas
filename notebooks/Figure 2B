import numpy as np
import pandas as pd

# 主要展示用三年龄组
combined.obs["age_group3"] = pd.cut(
    combined.obs["age_years"],
    bins=[0, 39, 54, np.inf],
    labels=["Young", "Middle", "Old"],
    right=True
)

# 与MERFISH一致的55岁分界
combined.obs["age_group55"] = pd.Categorical(
    np.where(
        combined.obs["age_years"] >= 55,
        "Old", "Young"
    ),
    categories=["Young", "Old"],
    ordered=True
)

# 只比较两端年龄段
combined.obs["extreme_age_group"] = pd.Categorical(
    np.select(
        [
            combined.obs["age_years"] <= 39,
            combined.obs["age_years"] >= 55
        ],
        ["Young", "Old"],
        default="Middle"
    ),
    categories=["Young", "Middle", "Old"],
    ordered=True
)

# 每位供体汇总一次，避免误把细胞当成独立供体
donor_groups = (
    combined.obs[
        ["unified_donor", "cohort",
         "age_years", "age_group3",
         "age_group55", "extreme_age_group"]
    ]
    .drop_duplicates(subset=["unified_donor"])
    .sort_values("age_years")
)

display(donor_groups)


