import scanpy as sc
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from pathlib import Path

root = Path("/home/ecs-user/skin_spatial_project")
outdir = root / "Integrated_8Donor_Skin" / "figures"
outdir.mkdir(parents=True, exist_ok=True)

# 如果重启过 Jupyter kernel，重新加载
if "basal" not in globals():
    basal = sc.read_h5ad(
        root / "Integrated_8Donor_Skin" /
        "BasalKC_8Donors_Clustered.h5ad"
    )

# 不同细胞身份的 marker
marker_groups = {
    "Basal KC": [
        "KRT5", "KRT14", "KRT15", "COL17A1"
    ],
    "Differentiation": [
        "KRT1", "KRT10", "DSG1"
    ],
    "Langerhans / Immune": [
        "CD207", "CD1A", "CD74", "PTPRC",
        "HLA-DRA", "LCP1"
    ],
    "Follicular-like": [
        "KRT17", "SOX9", "FOXC1"
    ],
    "Stress": [
        "HSPA1A", "DNAJB1", "FOS", "ATF3"
    ]
}

genes = list(dict.fromkeys(
    g for group in marker_groups.values()
    for g in group
    if g in basal.var_names
))

# UMAP marker expression
sc.pl.umap(
    basal,
    color=[
        "basal_cluster",
        "KRT14",
        "CD207",
        "PTPRC",
        "HLA-DRA",
        "KRT17"
    ],
    ncols=3,
    size=18,
    frameon=False,
    cmap="viridis",
    show=True
)

# Cluster 3 / 7 marker summaries
target_clusters = ["3", "7"]

sub = basal[
    basal.obs["basal_cluster"]
    .astype(str)
    .isin(target_clusters)
].copy()

from scipy import sparse

X = sub[:, genes].X
if sparse.issparse(X):
    X = X.toarray()

expr = pd.DataFrame(
    np.asarray(X),
    columns=genes,
    index=sub.obs_names
)

expr["cluster"] = sub.obs["basal_cluster"].astype(str).values

mean_expr = expr.groupby("cluster").mean()
positive_pct = expr.groupby("cluster").apply(
    lambda d: (d[genes] > 0).mean() * 100
)

print("Mean normalized expression:")
display(mean_expr.round(2))

print("Positive-cell fraction (%):")
display(positive_pct.round(1))




