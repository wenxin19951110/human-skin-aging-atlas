import scanpy as sc
import matplotlib.pyplot as plt
from pathlib import Path

root = Path("/home/ecs-user/skin_spatial_project")
outdir = root / "Integrated_8Donor_Skin" / "figures"
outdir.mkdir(parents=True, exist_ok=True)

# Load QC-filtered basal cells if necessary
if "basal_clean" not in globals():
    basal_clean = sc.read_h5ad(
        root / "Integrated_8Donor_Skin" /
        "BasalKC_8Donors_QCfiltered.h5ad"
    )

# Provisional biological annotation
annotation_map = {
    "0": "Heat-shock response",
    "1": "Immediate-early response",
    "2": "KRT14-associated basal",
    "3": "MHC-II-associated basal",
    "4": "Differentiation-associated",
    "5": "KRT17-associated basal",
    "6": "COL17A1-high basal"
}

basal_clean.obs["basal_annotation"] = (
    basal_clean.obs["basal_cluster"]
    .astype(str)
    .map(annotation_map)
)

# Ensure correct category order
basal_clean.obs["basal_annotation"] = (
    basal_clean.obs["basal_annotation"]
    .astype("category")
)

# Create annotated UMAP
fig = sc.pl.umap(
    basal_clean,
    color="basal_annotation",
    title="Basal keratinocyte transcriptional states",
    legend_loc="right margin",
    legend_fontsize=9,
    frameon=False,
    size=24,
    show=False,
    return_fig=True
)

# Save
png = outdir / "Fig3C_BasalKC_Annotated_UMAP.png"
pdf = outdir / "Fig3C_BasalKC_Annotated_UMAP.pdf"

fig.savefig(
    png,
    dpi=400,
    bbox_inches="tight",
    facecolor="white"
)

fig.savefig(
    pdf,
    bbox_inches="tight",
    facecolor="white"
)

plt.show()
plt.close(fig)

# Save annotations to AnnData
basal_clean.write_h5ad(
    root / "Integrated_8Donor_Skin" /
    "BasalKC_8Donors_Annotated.h5ad"
)

print("Saved PNG:", png)
print("Saved PDF:", pdf)
print("Annotated cells:", basal_clean.n_obs)









