import scanpy as sc
import pandas as pd

# Find cluster-enriched markers
sc.tl.rank_genes_groups(
    basal,
    groupby="basal_cluster",
    method="wilcoxon",
    use_raw=False,
    pts=True
)

# Extract top markers for every cluster
marker_tables = []

for cluster in basal.obs["basal_cluster"].cat.categories:
    df = sc.get.rank_genes_groups_df(
        basal,
        group=str(cluster)
    )

    df = df[
        (df["logfoldchanges"] > 0.5) &
        (df["pvals_adj"] < 0.05)
    ].head(10).copy()

    df["cluster"] = str(cluster)

    marker_tables.append(df)

markers_all = pd.concat(marker_tables)

marker_summary = (
    markers_all.groupby("cluster")["names"]
    .apply(lambda x: ", ".join(x))
    .reset_index(name="Top markers")
)

display(marker_summary)




