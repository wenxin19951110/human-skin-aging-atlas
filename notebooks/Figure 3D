
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.colors import TwoSlopeNorm, to_rgb
from matplotlib.patches import Patch
from pathlib import Path

root = Path("/home/ecs-user/skin_spatial_project")
outdir = root / "Integrated_8Donor_Skin" / "figures"

# Load previously saved donor means
csv_path = outdir / "Fig3E_BasalKC_19Genes_DonorMean.csv"
donor_mean = pd.read_csv(csv_path, index_col=0)

# Gene groups
gene_groups = {
    "Cell-ECM adhesion": [
        "ITGA3", "ITGA6", "ITGB1", "ITGB3",
        "ITGB4", "CD151", "DSC2", "LAMA3",
        "LAMB3", "COL7A1"
    ],
    "EpSC identity": [
        "ASS1", "SLC1A3", "KRT15",
        "COL17A1", "KRT5", "KRT14"
    ],
    "Proliferation": [
        "MKI67", "TOP2A", "PCNA"
    ]
}

genes = [
    gene
    for group in gene_groups.values()
    for gene in group
    if gene in donor_mean.columns
]

# Donor ages
age_map = {
    "Butt_23": 23, "LS_S1": 25, "LS_S2": 27,
    "Butt_53": 53, "LS_S3": 53,
    "LS_S5": 69, "LS_S4": 70,
    "Butt_85": 85
}

donors = sorted(
    [d for d in age_map if d in donor_mean.index],
    key=lambda d: (age_map[d], d)
)

# Gene-wise Z-score
expr = donor_mean.loc[donors, genes]
z = (
    (expr - expr.mean(axis=0))
    .div(expr.std(axis=0, ddof=0).replace(0, np.nan))
    .fillna(0)
)
z = z.clip(-2, 2)

# Publication-style layout
fig = plt.figure(figsize=(13.5, 4.8))

# Explicit axes: no overlapping labels/colorbar
ax_age = fig.add_axes([0.035, 0.30, 0.010, 0.46])
ax_cohort = fig.add_axes([0.050, 0.30, 0.010, 0.46])
ax = fig.add_axes([0.080, 0.30, 0.675, 0.46])
cax = fig.add_axes([0.920, 0.30, 0.015, 0.46])

im = ax.imshow(
    z.values,
    cmap="RdBu_r",
    norm=TwoSlopeNorm(vmin=-2, vcenter=0, vmax=2),
    aspect="auto",
    interpolation="nearest"
)

ax.set_xticks(range(len(genes)))
ax.set_xticklabels(
    genes,
    rotation=55,
    ha="right",
    rotation_mode="anchor",
    fontsize=8
)

ax.set_yticks(range(len(donors)))
ax.set_yticklabels(
    [f"{d} ({age_map[d]}y)" for d in donors],
    fontsize=8
)

ax.yaxis.tick_right()
ax.tick_params(axis="both", length=0, pad=4)

# Cell borders
ax.set_xticks(np.arange(-0.5, len(genes), 1), minor=True)
ax.set_yticks(np.arange(-0.5, len(donors), 1), minor=True)
ax.grid(which="minor", color="white", linewidth=0.7)
ax.tick_params(which="minor", bottom=False, left=False)

# Gene group boundaries
n1 = sum(g in genes for g in gene_groups["Cell-ECM adhesion"])
n2 = sum(g in genes for g in gene_groups["EpSC identity"])

for boundary in [n1, n1 + n2]:
    ax.axvline(boundary - 0.5, color="#333333", linewidth=1.1)

for spine in ax.spines.values():
    spine.set_visible(False)

# Age and cohort annotations
age_palette = {"Young": "#4C78A8", "Old": "#E08B58"}
cohort_palette = {
    "GSE274955": "#67A58D",
    "SoleBoldo_2020": "#9279AC"
}

age_rgb = np.array([
    to_rgb(age_palette["Old" if age_map[d] >= 60 else "Young"])
    for d in donors
]).reshape(len(donors), 1, 3)

cohort_rgb = np.array([
    to_rgb(cohort_palette[
        "GSE274955" if d.startswith("Butt")
        else "SoleBoldo_2020"
    ])
    for d in donors
]).reshape(len(donors), 1, 3)

for a, rgb, title in [
    (ax_age, age_rgb, "Age"),
    (ax_cohort, cohort_rgb, "Cohort")
]:
    a.imshow(rgb, aspect="auto")
    a.set_xticks([])
    a.set_yticks([])
    a.set_title(title, fontsize=8, rotation=90, pad=9)
    for spine in a.spines.values():
        spine.set_visible(False)

# Colorbar now has its own space
cb = fig.colorbar(im, cax=cax)
cb.set_ticks([-2, -1, 0, 1, 2])
cb.set_label("Gene-wise Z-score", fontsize=9)
cb.ax.tick_params(labelsize=8)
cb.outline.set_visible(False)

# Legend
handles = [
    Patch(color=age_palette["Young"], label="Young"),
    Patch(color=age_palette["Old"], label="Old"),
    Patch(color=cohort_palette["SoleBoldo_2020"], label="Solé-Boldo"),
    Patch(color=cohort_palette["GSE274955"], label="GSE274955")
]

fig.legend(
    handles=handles,
    loc="upper center",
    bbox_to_anchor=(0.48, 0.87),
    ncol=4,
    frameon=False,
    fontsize=9
)

fig.suptitle(
    "Basal keratinocyte expression programmes across donors",
    fontsize=13,
    fontweight="bold",
    y=0.97
)

# Save
png = outdir / "Fig3E_BasalKC_19Genes_Final.png"
pdf = outdir / "Fig3E_BasalKC_19Genes_Final.pdf"

fig.savefig(png, dpi=400, bbox_inches="tight", facecolor="white")
fig.savefig(pdf, bbox_inches="tight", facecolor="white")

plt.show()
plt.close(fig)

print("Saved PNG:", png)
print("Saved PDF:", pdf)





