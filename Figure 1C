import scanpy as sc
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from pathlib import Path

root = Path("/home/ecs-user/skin_spatial_project")

adata = sc.read_h5ad(
    root / "Restrepo_MERFISH" /
    "merfish.integrated_annotated.h5ad",
    backed="r"
)

# 只选腹股沟和臀部
sites = ["inguinal fold", "buttocks"]
mask = adata.obs["anatomic_site"].isin(sites).to_numpy()

# 只提取UMAP坐标和元数据，不读取基因矩阵
xy = np.asarray(adata.obsm["scanvi_umap"])[mask, :2]

meta = adata.obs.loc[
    mask,
    ["anatomic_site", "cell_type.broad", "cell_type.detailed"]
].copy().reset_index(drop=True)

print("Selected cells:", len(meta))
print(meta["anatomic_site"].value_counts())
print("\nBroad cell types:")
print(meta["cell_type.broad"].value_counts())


from matplotlib.lines import Line2D

# 将未分配或doublet标记排除（如存在）
valid = ~meta["cell_type.detailed"].astype(str).isin(
    ["Doublet", "Unknown"]
)

xy_plot = xy[valid.to_numpy()]
labels = meta.loc[valid, "cell_type.broad"].astype(str).to_numpy()

celltypes = sorted(pd.unique(labels))

# 使用分类色板
palette = plt.get_cmap("tab20")
colors = {
    ct: palette(i / max(len(celltypes)-1, 1))
    for i, ct in enumerate(celltypes)
}

fig, ax = plt.subplots(figsize=(10, 7.5))

for ct in celltypes:
    m = labels == ct
    ax.scatter(
        xy_plot[m, 0],
        xy_plot[m, 1],
        s=1,
        c=[colors[ct]],
        alpha=0.65,
        rasterized=True
    )

ax.set_title(
    "MERFISH | Inguinal fold and buttocks",
    fontsize=16, pad=15
)
ax.set_xlabel("UMAP 1", fontsize=12)
ax.set_ylabel("UMAP 2", fontsize=12)

ax.set_xticks([])
ax.set_yticks([])
ax.spines[["top", "right"]].set_visible(False)

handles = [
    Line2D(
        [0], [0],
        marker="o", linestyle="",
        color=colors[ct],
        markersize=7,
        label=ct
    )
    for ct in celltypes
]

ax.legend(
    handles=handles,
    bbox_to_anchor=(1.02, 1),
    loc="upper left",
    frameon=False,
    fontsize=10,
    ncol=1
)

fig.tight_layout()

outdir = root / "Restrepo_MERFISH" / "figures"
outdir.mkdir(parents=True, exist_ok=True)

png = outdir / "Fig1C_MERFISH_Inguinal_Buttocks_Broad_UMAP.png"
pdf = outdir / "Fig1C_MERFISH_Inguinal_Buttocks_Broad_UMAP.pdf"

fig.savefig(png, dpi=400, bbox_inches="tight",
            facecolor="white")
fig.savefig(pdf, bbox_inches="tight",
            facecolor="white")

plt.show()

print("Saved:", png)
print("Included cells:", len(labels))
